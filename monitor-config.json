{
  "network": {
    "timeoutSec": 20,
    "requestDelayMs": 500,
    "proxyUrl": "",
    "userAgent": "ShoppingDealRSS/1.1 (+https://github.com/StartFullSky/shopping-deal-rss)"
  },
  "monitor": {
    "intervalMinutes": 5,
    "maxLookbackMinutes": 180,
    "maxDetailFetchesPerRun": 16,
    "maxAlertsPerRun": 2
  },
  "quality": {
    "minScore": 88,
    "minHistoricalDiscountPct": 30,
    "requireHistoricalPrice": true
  },
  "ai": {
    "enabled": true,
    "model": "",
    "codexCommandPath": "",
    "minConfidence": 0.8,
    "minHistoricalDiscountPct": 30,
    "maxReviewsPerRun": 2,
    "timeoutSec": 30
  },
  "delivery": {
    "barkSecretPath": "%USERPROFILE%\\.codex\\secrets\\shopping-deal-rss-bark.bin",
    "statePath": "%USERPROFILE%\\.codex\\state\\shopping-deal-rss-state.json",
    "resultPath": "%USERPROFILE%\\.codex\\state\\shopping-deal-rss-last-run.json"
  },
  "rules": {
    "includeKeywords": [],
    "excludeKeywords": [],
    "alwaysKeepPatterns": [
      "错价|价格错误|标价错误|价格漏洞|漏洞价|白嫖",
      "叠券|叠加.{0,8}(?:券|补贴|红包)|加车.{0,12}改|隐藏入口|受邀",
      "实付.{0,12}低于|结算.{0,12}低于"
    ],
    "excludePatterns": [
      "(?i)(?:图书|书籍|书本|电子书|有声书|(?<!儿)童书|绘本|漫画|小说|教辅|教材|课外书|读物|词典|字帖|练习册|作文书|读书|kindle|图书券|图书卡|当当.{0,6}书)",
      "今日.{0,6}(?:特价|好价)",
      "限时.{0,6}(?:特价|秒杀)",
      "聚划算|团购|拼团"
    ],
    "dealTypes": {
      "price-error": [
        "错价|价格错误|标价错误|价格漏洞|漏洞价|价格BUG|价格bug|BUG价"
      ],
      "zero-price": [
        "(?<![¥￥\\d.])0(?:\\.0+)?\\s*(?:元|亓)(?:购|拍|下单|到手)|零元购|一元购|1元购|白嫖|(?:实付|到手|最终|下单|付款)\\s*0(?:\\.0+)?\\s*(?:元|亓)"
      ],
      "flash-inventory": [
        "库存漏洞|库存错误|超卖|无货下单|秒罄"
      ],
      "coupon-stack": [
        "(?s)^(?=.*(?:领|領|领取|使用).{0,20}(?:券|劵|红包))(?=.*(?:跳\\s*APP|进.{0,4}(?:直播|値播)|拍下|拍卞|加\\s*🛒|凑|湊|叠加|再领|支付券|平台券|店铺券|加车|满\\d+减\\d+))"
      ],
      "hidden-stack": [
        "叠券漏洞|隐藏叠券|未显示.{0,8}叠加|(?:券|补贴|红包).{0,8}叠加.{0,8}(?:漏洞|隐藏)|支付券.{0,8}叠加.{0,8}(?:未显示|隐藏)"
      ],
      "hidden-eligibility": [
        "隐藏入口|隐藏.{0,8}小程序|仅限.{0,12}(?:地区|账号|会员|学生|新客|老客)|受邀|白号|黑号|特定渠道"
      ],
      "channel-specific": [
        "仅限.{0,12}(?:小程序|APP|线下|门店|地区|渠道)|地区专享|渠道专享"
      ],
      "checkout-mismatch": [
        "(?:价格|忦格).{0,4}(?:不对|不一致|错误)|结算.{0,12}(?:低于|不一致|价格)|购物车.{0,12}(?:低于|不一致)|实付.{0,12}低于|下单.{0,12}低于"
      ],
      "variant-mismatch": [
        "发错|(?:拍|购|下)\\s*\\d+\\s*(?:件|个|盒|瓶|双)?.{0,16}(?:实际|收到|实发).{0,12}(?:发|货).{0,12}(?:错|不一致)|SKU.{0,12}(?:错|bug|不一致)|规格.{0,12}(?:错|bug|不一致)|选项.{0,12}(?:错|bug|不一致)|收到.{0,12}(?:规格|型号|颜色).{0,8}(?:错|不一致)"
      ],
      "target-price-met": [
        "达到目标价|低于目标价|目标价达成"
      ],
      "abnormal-drop": [
        "异常降价|突然降价"
      ]
    }
  },
  "sources": [
    {
      "id": "xianbao",
      "kind": "xianbao-detail",
      "url": "https://new.xianbao.fun/rss.php",
      "enabled": true,
      "maxLookbackMinutes": 720
    }
  ]
}
